// 配置通过转译或类型擦除在 Node.js 环境中运行的模块。
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    // 多数工具会先进行转译，再交给 Node.js 执行。
    // 使用打包工具的模块解析方式，兼容本项目的开发工具。
    "module": "preserve",
    "moduleResolution": "bundler",

    // 仅引入 Node.js 类型，避免意外加载其他 `@types/*` 类型包。
    "types": ["node"],

    // `vue-tsc --build` 仅执行类型检查，不输出编译文件。
    "noEmit": true,

    // `vue-tsc --build` 会生成增量类型检查所需的 .tsbuildinfo 文件。
    // 在此指定缓存位置，避免文件生成在项目根目录。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
